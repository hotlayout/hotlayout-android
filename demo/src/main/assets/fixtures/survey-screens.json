{
  "schemaVersion": "9.14.0",
  "documentId": "survey",
  "name": "Survey: required fields, a disabled button, a number field",
  "initialScreenId": "goal",
  "screens": [
    {
      "screenId": "goal",
      "name": "Step 1: one answer",
      "root": {
        "id": "goal-root",
        "type": "Screen",
        "props": {
          "gap": "lg"
        },
        "style": {
          "padding": "lg",
          "background": {
            "kind": "color",
            "color": "surface"
          }
        },
        "children": [
          {
            "id": "goal-bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "Quick survey"
              },
              "showBack": false
            },
            "style": {
              "padding": {
                "top": "sm",
                "bottom": "sm"
              }
            }
          },
          {
            "id": "goal-step",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "Step 1 of 3"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "color": "muted",
              "typography": "bodyS"
            }
          },
          {
            "id": "goal-question",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "What brings you to the programme?"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "typography": "titleM"
            }
          },
          {
            "id": "goal-choice",
            "type": "ChoiceGroup",
            "props": {
              "value": {
                "kind": "binding",
                "path": "survey.goal",
                "fallback": ""
              },
              "gap": "none",
              "required": true
            },
            "children": [
              {
                "id": "rewards",
                "type": "ListTile",
                "props": {
                  "leading": {
                    "kind": "none"
                  },
                  "title": {
                    "kind": "literal",
                    "value": "Rewards"
                  },
                  "subtitle": {
                    "kind": "literal",
                    "value": "I want to exchange points for gifts"
                  },
                  "trailing": {
                    "kind": "radio",
                    "optionValue": "rewards"
                  }
                }
              },
              {
                "id": "savings",
                "type": "ListTile",
                "props": {
                  "leading": {
                    "kind": "none"
                  },
                  "title": {
                    "kind": "literal",
                    "value": "Savings"
                  },
                  "subtitle": {
                    "kind": "literal",
                    "value": "I want to spend less on what I already buy"
                  },
                  "trailing": {
                    "kind": "radio",
                    "optionValue": "savings"
                  }
                }
              },
              {
                "id": "curious",
                "type": "ListTile",
                "props": {
                  "leading": {
                    "kind": "none"
                  },
                  "title": {
                    "kind": "literal",
                    "value": "Just looking"
                  },
                  "subtitle": {
                    "kind": "literal",
                    "value": "I have not decided yet"
                  },
                  "trailing": {
                    "kind": "radio",
                    "optionValue": "curious"
                  }
                }
              }
            ]
          },
          {
            "id": "goal-next",
            "type": "Button",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Next"
              },
              "variant": "primary",
              "action": {
                "type": "navigate",
                "params": {
                  "screenId": "details"
                }
              },
              "fullWidth": true,
              "requiresFilled": true
            },
            "pin": "bottom"
          }
        ]
      }
    },
    {
      "screenId": "details",
      "name": "Step 2: text and a number",
      "root": {
        "id": "details-root",
        "type": "Screen",
        "props": {
          "gap": "lg"
        },
        "style": {
          "padding": "lg",
          "background": {
            "kind": "color",
            "color": "surface"
          }
        },
        "children": [
          {
            "id": "details-bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "About you"
              },
              "showBack": true
            },
            "style": {
              "padding": {
                "top": "sm",
                "bottom": "sm"
              }
            }
          },
          {
            "id": "details-step",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "Step 2 of 3"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "color": "muted",
              "typography": "bodyS"
            }
          },
          {
            "id": "name",
            "type": "TextField",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Your name"
              },
              "value": {
                "kind": "binding",
                "path": "survey.name"
              },
              "required": true,
              "placeholder": {
                "kind": "literal",
                "value": "How should we address you"
              },
              "maxLength": 40
            }
          },
          {
            "id": "age",
            "type": "TextField",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Your age"
              },
              "value": {
                "kind": "binding",
                "path": "survey.age"
              },
              "valueType": "number",
              "required": true,
              "helper": {
                "kind": "literal",
                "value": "Full years, digits only."
              },
              "maxLength": 3
            }
          },
          {
            "id": "comment",
            "type": "TextField",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Anything to add?"
              },
              "value": {
                "kind": "binding",
                "path": "survey.comment"
              },
              "placeholder": {
                "kind": "literal",
                "value": "Optional"
              },
              "maxLength": 400,
              "lines": 3
            }
          },
          {
            "id": "details-next",
            "type": "Button",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Next"
              },
              "variant": "primary",
              "action": {
                "type": "navigate",
                "params": {
                  "screenId": "consent"
                }
              },
              "fullWidth": true,
              "requiresFilled": true
            },
            "pin": "bottom"
          }
        ]
      }
    },
    {
      "screenId": "consent",
      "name": "Step 3: consent",
      "root": {
        "id": "consent-root",
        "type": "Screen",
        "props": {
          "gap": "lg"
        },
        "style": {
          "padding": "lg",
          "background": {
            "kind": "color",
            "color": "surface"
          }
        },
        "children": [
          {
            "id": "consent-bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "Almost done"
              },
              "showBack": true
            },
            "style": {
              "padding": {
                "top": "sm",
                "bottom": "sm"
              }
            }
          },
          {
            "id": "consent-step",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "Step 3 of 3"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "color": "muted",
              "typography": "bodyS"
            }
          },
          {
            "id": "consent-name",
            "type": "Text",
            "props": {
              "content": {
                "kind": "binding",
                "path": "survey.name",
                "fallback": "—"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "typography": "titleM"
            }
          },
          {
            "id": "agree",
            "type": "Checkbox",
            "props": {
              "label": {
                "kind": "literal",
                "value": "I agree that my answers are used to improve the programme"
              },
              "value": {
                "kind": "binding",
                "path": "survey.agreed"
              },
              "required": true
            }
          },
          {
            "id": "consent-age-note",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "The survey is for people of 16 and older."
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "visibleIf": {
              "path": "survey.age",
              "op": "lt",
              "value": 16
            },
            "style": {
              "color": "danger",
              "typography": "bodyS"
            }
          },
          {
            "id": "send",
            "type": "Button",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Send answers"
              },
              "variant": "primary",
              "action": {
                "type": "navigate",
                "params": {
                  "screenId": "done"
                }
              },
              "fullWidth": true,
              "requiresFilled": true,
              "disabledIf": {
                "path": "survey.age",
                "op": "lt",
                "value": 16
              }
            },
            "pin": "bottom"
          }
        ]
      }
    },
    {
      "screenId": "done",
      "name": "Thank you",
      "root": {
        "id": "done-root",
        "type": "Screen",
        "props": {
          "gap": "lg"
        },
        "style": {
          "padding": "lg",
          "background": {
            "kind": "color",
            "color": "surface"
          }
        },
        "children": [
          {
            "id": "done-bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "Thank you"
              },
              "showBack": false
            },
            "style": {
              "padding": {
                "top": "sm",
                "bottom": "sm"
              }
            }
          },
          {
            "id": "done-title",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "Your answers are sent"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "typography": "titleM"
            }
          },
          {
            "id": "done-text",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "We read every one of them. You can take the survey again at any time."
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "color": "muted",
              "typography": "bodyS"
            }
          },
          {
            "id": "again",
            "type": "Button",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Start over"
              },
              "variant": "primary",
              "action": {
                "type": "navigate.section",
                "params": {
                  "screenId": "goal"
                }
              },
              "fullWidth": true
            },
            "pin": "bottom"
          }
        ]
      }
    }
  ],
  "localization": {
    "defaultLocale": "en",
    "locales": [
      "en",
      "uk",
      "ar"
    ],
    "strings": {
