            "props": {
              "gap": "sm",
              "align": "center",
              "justify": "start",
              "wrap": false,
              "scrollable": false
            },
            "children": [
              {
                "id": "details-limited",
                "type": "Badge",
                "props": {
                  "label": {
                    "kind": "literal",
                    "value": "LIMITED"
                  },
                  "tone": "danger",
                  "icon": "flame",
                  "iconPosition": "start"
                }
              },
              {
                "id": "details-new",
                "type": "Badge",
                "props": {
                  "label": {
                    "kind": "literal",
                    "value": "New"
                  },
                  "tone": "success"
                }
              }
            ]
          },
          {
            "id": "details-body",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "Any drink, any size. Show the code at the counter."
              },
              "align": "start",
              "overflow": "ellipsis"
            }
          },
          {
            "id": "details-redeem",
            "type": "Button",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Redeem"
              },
              "variant": "primary",
              "action": {
                "type": "submit"
              },
              "fullWidth": true,
              "icon": "chevron-right",
              "iconPosition": "end",
              "size": "lg"
            }
          }
        ]
      }
    }
  ],
