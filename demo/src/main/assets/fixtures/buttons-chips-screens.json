                    "kind": "literal",
                    "value": "Back"
                  },
                  "variant": "ghost",
                  "size": "md",
                  "action": {
                    "type": "navigate.back"
                  }
                }
              },
              {
                "id": "details-title",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "literal",
                    "value": "Coffee voucher"
                  },
                  "align": "start",
                  "overflow": "ellipsis"
                },
                "style": {
                  "typography": "titleM"
                },
                "weight": 1
              },
              {
                "id": "details-info",
                "type": "IconButton",
                "props": {
                  "icon": "info",
                  "label": {
                    "kind": "literal",
                    "value": "How it works"
                  },
                  "variant": "ghost",
                  "size": "md",
