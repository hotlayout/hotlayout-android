          }
        },
        "children": [
          {
            "id": "terms-bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "How points work"
              },
              "showBack": true
            },
            "style": {
              "padding": {
                "top": "sm",
                "bottom": "sm"
              }
            }
          },
          {
            "id": "terms-card",
            "type": "Container",
            "props": {
              "direction": "column",
              "gap": "sm"
            },
            "style": {
              "padding": "lg",
              "radius": "lg",
              "background": {
                "kind": "color",
                "color": "surface"
              }
            },
            "children": [
              {
                "id": "terms-1",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "literal",
                    "value": "Points are added within a day after a task is done. If they are not there after two days, write to support from the profile screen."
                  },
                  "align": "start",
                  "overflow": "ellipsis"
                }
              },
              {
                "id": "terms-2",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "literal",
                    "value": "A task counts once. Doing it again on the same day brings nothing: the list on the home screen shows what is still open."
                  },
                  "align": "start",
                  "overflow": "ellipsis"
                }
              },
              {
                "id": "terms-3",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "literal",
                    "value": "Points do not expire while you open the app at least once in ninety days. After that they are kept for another thirty days and then removed."
                  },
                  "align": "start",
                  "overflow": "ellipsis"
                }
              },
              {
                "id": "terms-4",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "literal",
                    "value": "A reward is reserved for you for fifteen minutes after you press the button. If you do not confirm, the points come back."
                  },
                  "align": "start",
                  "overflow": "ellipsis"
                }
              },
              {
                "id": "terms-5",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "literal",
                    "value": "Delivery is free. A reward that was not picked up in ten days goes back to the catalogue, and the points go back to you."
