{
  "description": "Alignment of children on both axes in a column, a container and a screen (schema 9.15.0). Cases shared by every reader of the contract, written by hand. `readCases`: which axis is the main one and which words act — `node` is a node with its raw props (anything may stand there), `mainAxis` is `block` (top to bottom), `inline` (along the line of the script) or `null` when the node has no fields of 9.15.0; `align` and `justify` are the words that ACT after the rule «no field or an unknown word — as without the field». `heightSourceCases`: what gives a column host a height larger than its content — `own` says which of `style.height` / `style.minHeight` the node names (after states), `parent` is the type of the parent, `fill` is the raw field of the node; `source` is a word of `x-style.layout.alignment.main.column.heightSources` or `null`; `space` — whether the main axis of this host CAN have free space (`null` — the node is not a host). `shiftCases`: how far each of `count` children moves along the main axis from the place it has with `start`. `boxCases`: rectangles of the children inside the CONTENT box of the host, in logical pixels, not rounded; `x` is measured from the LEFT edge of the content box in both directions of the script, `y` from its top. `inline` is the width of the content box; `block` is its named height (`style.height`, a layer with `fill`), `minBlock` is `style.minHeight`; neither — the box is as tall as its content. A child is `{ width, height }` with its own margins included; `stretch: true` is a child the column stretches (its `width` is then not read). In a row host `stretch` and `minBlock` are not read. `expect.block` is the height of the content box, `expect.free` the free space on the main axis. `screenCases`: the body of a screen — the input is the input of the zones (`contract/fixtures/bottom-zone/bottom-zone-cases.json`, `zoneCases`) plus the heights of the visible children of the body; `expect.body` is the area of the body in screen coordinates, `free` its free space, `tops` the top edge of every child of the body in screen coordinates with the body not scrolled. `ruleCases`: a path inside `x-style.layout.alignment` and its value.",

  "readCases": [
    { "name": "a column without the new field: the main axis is vertical, both words are «start»", "node": { "type": "Column", "props": { "gap": "sm", "align": "start" } }, "expect": { "mainAxis": "block", "align": "start", "justify": "start" } },
    { "name": "a column with both words", "node": { "type": "Column", "props": { "gap": "sm", "align": "center", "justify": "between" } }, "expect": { "mainAxis": "block", "align": "center", "justify": "between" } },
    { "name": "a column with an unknown word of the main axis: as without the field", "node": { "type": "Column", "props": { "gap": "sm", "align": "end", "justify": "around" } }, "expect": { "mainAxis": "block", "align": "end", "justify": "start" } },
    { "name": "a column with a number instead of a word", "node": { "type": "Column", "props": { "gap": "sm", "align": "start", "justify": 1 } }, "expect": { "mainAxis": "block", "align": "start", "justify": "start" } },
    { "name": "a container without fields is a column: children at the start, as before 9.15.0", "node": { "type": "Container", "props": { "gap": "none" } }, "expect": { "mainAxis": "block", "align": "start", "justify": "start" } },
    { "name": "a column container with both words", "node": { "type": "Container", "props": { "direction": "column", "gap": "none", "align": "center", "justify": "end" } }, "expect": { "mainAxis": "block", "align": "center", "justify": "end" } },
    { "name": "a column container: «stretch» is not a word of the contract", "node": { "type": "Container", "props": { "direction": "column", "gap": "none", "align": "stretch" } }, "expect": { "mainAxis": "block", "align": "start", "justify": "start" } },
    { "name": "a row container without fields: children centred vertically, as before 9.15.0", "node": { "type": "Container", "props": { "direction": "row", "gap": "none" } }, "expect": { "mainAxis": "inline", "align": "center", "justify": "start" } },
    { "name": "a row container with both words", "node": { "type": "Container", "props": { "direction": "row", "gap": "none", "align": "end", "justify": "between" } }, "expect": { "mainAxis": "inline", "align": "end", "justify": "between" } },
    { "name": "a row container with an unknown word of the cross axis: centre, not start", "node": { "type": "Container", "props": { "direction": "row", "gap": "none", "align": "stretch" } }, "expect": { "mainAxis": "inline", "align": "center", "justify": "start" } },
    { "name": "a screen without fields", "node": { "type": "Screen", "props": { "gap": "sm" } }, "expect": { "mainAxis": "block", "align": "start", "justify": "start" } },
    { "name": "a screen with both words", "node": { "type": "Screen", "props": { "gap": "sm", "align": "center", "justify": "center" } }, "expect": { "mainAxis": "block", "align": "center", "justify": "center" } },
    { "name": "a screen: «null» is no field", "node": { "type": "Screen", "props": { "gap": "sm", "align": null, "justify": null } }, "expect": { "mainAxis": "block", "align": "start", "justify": "start" } },
    { "name": "a row is not a host of 9.15.0: its fields are older and have schema defaults", "node": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "start", "wrap": false } }, "expect": { "mainAxis": null } },
    { "name": "a text has no axes", "node": { "type": "Text", "props": {} }, "expect": { "mainAxis": null } }
  ],

  "heightSourceCases": [
    { "name": "a column as tall as its content: no source, no free space", "node": { "type": "Column", "props": {} }, "parent": "Screen", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "a column with a named height", "node": { "type": "Column", "props": {} }, "parent": "Screen", "own": { "height": true, "minHeight": false }, "expect": { "source": "style.height", "space": true } },
    { "name": "a column with a minimal height", "node": { "type": "Column", "props": {} }, "parent": "Screen", "own": { "height": false, "minHeight": true }, "expect": { "source": "style.minHeight", "space": true } },
    { "name": "both are named: the height is the source", "node": { "type": "Column", "props": {} }, "parent": "Container", "own": { "height": true, "minHeight": true }, "expect": { "source": "style.height", "space": true } },
    { "name": "a layer filling a stack: the stack gives the height", "node": { "type": "Column", "props": {}, "fill": true }, "parent": "Stack", "own": { "height": false, "minHeight": false }, "expect": { "source": "fill", "space": true } },
    { "name": "a filling layer with its own height: the fill is stronger", "node": { "type": "Column", "props": {}, "fill": true }, "parent": "Stack", "own": { "height": true, "minHeight": false }, "expect": { "source": "fill", "space": true } },
    { "name": "«fill» outside a stack is not read", "node": { "type": "Column", "props": {}, "fill": true }, "parent": "Column", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "«fill» that is not «true» is not read", "node": { "type": "Column", "props": {}, "fill": "yes" }, "parent": "Stack", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "a plain layer of a stack takes its own size", "node": { "type": "Column", "props": {} }, "parent": "Stack", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "a cell of a grid does not give a height: the grid aligns cells to the top", "node": { "type": "Column", "props": {} }, "parent": "Grid", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "a row does not give a height: «Row.align» has no «stretch»", "node": { "type": "Column", "props": {} }, "parent": "Row", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "a tab is as tall as its content", "node": { "type": "Column", "props": {} }, "parent": "Tab", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "an instance of a list from data", "node": { "type": "Column", "props": {} }, "parent": "Repeater", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "a column container as tall as its content", "node": { "type": "Container", "props": { "direction": "column" } }, "parent": "Screen", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": false } },
    { "name": "a container without «direction» is a column", "node": { "type": "Container", "props": {} }, "parent": "Screen", "own": { "height": false, "minHeight": true }, "expect": { "source": "style.minHeight", "space": true } },
    { "name": "a column container filling a stack", "node": { "type": "Container", "props": { "direction": "column" }, "fill": true }, "parent": "Stack", "own": { "height": false, "minHeight": false }, "expect": { "source": "fill", "space": true } },
    { "name": "a row container: the main axis is the width, free space is possible without any height", "node": { "type": "Container", "props": { "direction": "row" } }, "parent": "Screen", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": true } },
    { "name": "a screen: the free space is the visible body, no height has to be named", "node": { "type": "Screen", "props": {} }, "parent": null, "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": true } },
    { "name": "a row is not a host", "node": { "type": "Row", "props": {} }, "parent": "Screen", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": null } },
    { "name": "a text is not a host", "node": { "type": "Text", "props": {} }, "parent": "Column", "own": { "height": false, "minHeight": false }, "expect": { "source": null, "space": null } }
  ],

  "shiftCases": [
    { "name": "start: nobody moves", "free": 260, "count": 3, "justify": "start", "expect": [0, 0, 0] },
    { "name": "center: everyone moves by half of the free space", "free": 260, "count": 3, "justify": "center", "expect": [130, 130, 130] },
    { "name": "end: everyone moves by the whole free space", "free": 260, "count": 3, "justify": "end", "expect": [260, 260, 260] },
    { "name": "between: the free space is split into equal parts between neighbours", "free": 260, "count": 3, "justify": "between", "expect": [0, 130, 260] },
    { "name": "between with four children: thirds, not rounded", "free": 100, "count": 4, "justify": "between", "expect": [0, 33.333333333333336, 66.66666666666667, 100] },
    { "name": "between with one child is start", "free": 260, "count": 1, "justify": "between", "expect": [0] },
    { "name": "center with one child", "free": 260, "count": 1, "justify": "center", "expect": [130] },
    { "name": "an odd free space: the half is not rounded", "free": 207, "count": 2, "justify": "center", "expect": [103.5, 103.5] },
    { "name": "no free space: center is start", "free": 0, "count": 3, "justify": "center", "expect": [0, 0, 0] },
    { "name": "no free space: between is start", "free": 0, "count": 3, "justify": "between", "expect": [0, 0, 0] },
    { "name": "content larger than the box: nobody moves backwards", "free": -40, "count": 2, "justify": "end", "expect": [0, 0] },
    { "name": "no children", "free": 260, "count": 0, "justify": "center", "expect": [] }
  ],

