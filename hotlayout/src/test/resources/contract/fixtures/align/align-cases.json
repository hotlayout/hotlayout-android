    { "name": "a column as tall as its content has no free space", "rule": "main.column.contentHeight", "expect": "no-free-space" },
    { "name": "there is no weight in a column", "rule": "main.column.weight", "expect": "none" },
    { "name": "the cross axis of a column host is the old rule of the column", "rule": "cross.block.rule", "expect": "column.naturalWidthAlign" },
    { "name": "stretched children keep the full width", "rule": "cross.block.stretched", "expect": "full-width-at-any-align" },
    { "name": "a column host without «align»: start", "rule": "cross.block.withoutProp", "expect": "start" },
    { "name": "a row host without «align»: center", "rule": "cross.inline.withoutProp", "expect": "center" },
    { "name": "the screen places only the children of the body", "rule": "screen.children", "expect": "body-only" },
    { "name": "the zones that take no part", "rule": "screen.notPlaced", "expect": ["appBar", "pinned", "navBar"] },
    { "name": "taller content scrolls", "rule": "screen.tallerContent", "expect": "scrolls-and-justify-is-not-read" },
    { "name": "a layer as tall as its content has no free space", "rule": "screen.shrunkLayer", "expect": "no-free-space" },
    { "name": "the validator says nothing about a field without free space", "rule": "validator", "expect": "silent-without-free-space" }
  ]
}
