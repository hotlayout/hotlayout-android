{
  "schemaVersion": "9.4.0",
  "documentId": "template-text",
  "name": "Text templates, numbers and plurals",
  "initialScreenId": "progress",
  "screens": [
    {
      "screenId": "progress",
      "name": "Progress",
      "root": {
        "id": "progress-root",
        "type": "Screen",
        "props": {
          "gap": "md"
        },
        "style": {
          "padding": "lg",
          "background": {
            "kind": "color",
            "color": "surface"
          }
        },
        "children": [
          {
            "id": "bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "Your week"
              },
              "subtitle": {
                "kind": "template",
                "template": "Level {level} · {points} {unit}",
                "values": {
                  "level": {
                    "kind": "binding",
                    "path": "user.level",
                    "fallback": "1"
                  },
                  "points": {
                    "kind": "binding",
                    "path": "user.points",
                    "fallback": "0",
                    "format": "number"
                  },
                  "unit": {
                    "kind": "plural",
                    "of": "points",
                    "forms": {
                      "one": "point",
                      "other": "points"
                    }
                  }
                }
              },
              "showBack": false
            }
          },
          {
            "id": "steps",
            "type": "Text",
            "props": {
              "content": {
                "kind": "template",
                "template": "{done} / {total} steps",
                "values": {
                  "done": {
                    "kind": "binding",
                    "path": "task.progress",
                    "fallback": "—"
                  },
                  "total": {
                    "kind": "binding",
                    "path": "task.target",
                    "fallback": "—"
                  }
                }
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "typography": "titleM"
            }
          },
          {
            "id": "days",
            "type": "Text",
            "props": {
              "content": {
                "kind": "template",
                "template": "{days} {unit} left",
                "values": {
                  "days": {
                    "kind": "binding",
                    "path": "campaign.endsAt",
                    "fallback": "—",
                    "format": "daysUntil"
                  },
                  "unit": {
                    "kind": "plural",
                    "of": "days",
                    "forms": {
                      "one": "day",
                      "other": "days"
                    }
                  }
                }
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "color": "muted",
              "typography": "bodyS"
            }
          },
          {
            "id": "balance-row",
            "type": "Row",
            "props": {
              "gap": "sm",
              "align": "center",
              "justify": "between",
              "wrap": false,
              "scrollable": false
            },
            "children": [
              {
                "id": "balance-label",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "literal",
                    "value": "Balance"
                  },
                  "align": "start",
                  "overflow": "ellipsis"
                },
                "style": {
                  "color": "muted",
                  "typography": "bodyS"
                }
              },
              {
                "id": "balance",
                "type": "Text",
                "props": {
                  "content": {
                    "kind": "binding",
                    "path": "user.points",
                    "fallback": "0",
                    "format": "number"
                  },
                  "align": "start",
                  "overflow": "ellipsis"
                },
                "style": {
                  "typography": "titleM"
                }
              }
            ]
          },
          {
            "id": "discount",
            "type": "Badge",
            "props": {
              "label": {
                "kind": "template",
                "template": "−{percent}%",
                "values": {
                  "percent": {
                    "kind": "binding",
                    "path": "offer.discountPercent",
                    "fallback": "0"
                  }
                }
              },
              "tone": "accent"
            }
          },
          {
            "id": "offer-row",
            "type": "ListTile",
            "props": {
              "leading": {
                "kind": "icon",
                "icon": "gift"
              },
              "title": {
                "kind": "binding",
                "path": "offer.title",
                "fallback": "Offer"
              },
              "subtitle": {
                "kind": "template",
                "template": "Ends in {days} {unit}",
                "values": {
                  "days": {
                    "kind": "binding",
                    "path": "offer.endsAt",
                    "fallback": "—",
                    "format": "daysUntil"
                  },
                  "unit": {
                    "kind": "plural",
                    "of": "days",
                    "forms": {
                      "one": "day",
                      "other": "days"
                    }
                  }
                }
              },
              "trailing": {
                "kind": "text",
                "text": {
                  "kind": "binding",
                  "path": "offer.price",
                  "fallback": "—",
                  "format": "currency",
                  "currency": "JOD"
                }
              },
              "action": {
                "type": "navigate",
                "params": {
                  "screenId": "offer"
                }
              }
            }
          },
          {
            "id": "tasks-heading",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "Missions"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "typography": "titleM"
            }
          },
          {
            "id": "tasks",
            "type": "Repeater",
            "props": {
              "source": "tasks",
              "item": "task",
              "direction": "column",
              "gap": "sm"
            },
            "children": [
              {
                "id": "task-row",
                "type": "ListTile",
                "props": {
                  "leading": {
                    "kind": "none"
                  },
                  "title": {
                    "kind": "binding",
                    "path": "task.title",
                    "fallback": "Mission"
                  },
                  "subtitle": {
                    "kind": "template",
                    "template": "{done} of {total}",
                    "values": {
                      "done": {
                        "kind": "binding",
                        "path": "task.progress",
                        "fallback": "0"
                      },
                      "total": {
                        "kind": "binding",
                        "path": "task.target",
                        "fallback": "5"
                      }
                    }
                  },
                  "trailing": {
                    "kind": "text",
                    "text": {
                      "kind": "template",
                      "template": "+{reward} {unit}",
                      "values": {
                        "reward": {
                          "kind": "binding",
                          "path": "task.rewardPoints",
                          "fallback": "0",
                          "format": "number"
                        },
                        "unit": {
                          "kind": "plural",
                          "of": "reward",
                          "forms": {
                            "one": "point",
                            "other": "points"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "screenId": "offer",
      "name": "Offer",
      "root": {
        "id": "offer-root",
        "type": "Screen",
        "props": {
          "gap": "md"
        },
        "style": {
          "padding": "lg",
          "background": {
            "kind": "color",
            "color": "surface"
          }
        },
        "children": [
          {
            "id": "offer-bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "Offer"
              },
              "showBack": true
            }
          },
          {
            "id": "offer-title",
            "type": "Text",
            "props": {
              "content": {
                "kind": "binding",
                "path": "offer.title",
                "fallback": "Offer"
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "typography": "titleM"
            }
          },
          {
            "id": "offer-price",
            "type": "Text",
            "props": {
              "content": {
                "kind": "template",
                "template": "Only {price} until {date}",
                "values": {
                  "price": {
                    "kind": "binding",
                    "path": "offer.price",
                    "fallback": "—",
                    "format": "currency",
                    "currency": "JOD"
                  },
                  "date": {
                    "kind": "binding",
                    "path": "offer.endsAt",
                    "fallback": "—",
                    "format": "date"
                  }
                }
              },
              "align": "start",
              "overflow": "ellipsis"
            }
          },
          {
            "id": "offer-days",
            "type": "Text",
            "props": {
              "content": {
                "kind": "template",
                "template": "{days} {unit} left",
                "values": {
                  "days": {
                    "kind": "binding",
                    "path": "offer.endsAt",
                    "fallback": "—",
                    "format": "daysUntil"
                  },
                  "unit": {
                    "kind": "plural",
                    "of": "days",
                    "forms": {
                      "one": "day",
                      "other": "days"
                    }
                  }
                }
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "color": "muted",
              "typography": "bodyS"
            }
          },
          {
            "id": "offer-code",
            "type": "Text",
            "props": {
              "content": {
                "kind": "template",
                "template": "Use code {code} at checkout",
                "values": {
                  "code": {
                    "kind": "binding",
                    "path": "offer.code",
                    "fallback": "CODE"
                  }
                }
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "typography": "bodyS"
            }
          }
        ]
      }
    }
  ],
  "localization": {
    "defaultLocale": "en",
    "locales": [
      "en",
      "uk",
      "ar"
    ],
    "strings": {
