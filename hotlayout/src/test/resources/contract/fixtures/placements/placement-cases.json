  "showingCases": [
    {
      "name": "a document without an entry starts on its initial screen",
      "resolution": { "status": "document", "documentId": "d1", "entry": null },
      "document": { "kind": "ok", "entryPoints": ["raffle"] },
      "expected": { "show": "document", "entry": null, "report": null }
    },
    {
      "name": "a document with an entry it has",
      "resolution": { "status": "document", "documentId": "d1", "entry": "raffle" },
      "document": { "kind": "ok", "entryPoints": ["rules", "raffle"] },
      "expected": { "show": "document", "entry": "raffle", "report": null }
    },
    {
      "name": "an entry the document no longer has: initial screen, and the host is told",
      "resolution": { "status": "document", "documentId": "d1", "entry": "raffle" },
      "document": { "kind": "ok", "entryPoints": ["rules"] },
      "expected": { "show": "document", "entry": null, "report": "entryMissing" }
    },
    {
      "name": "an entry and a document with no entry points",
      "resolution": { "status": "document", "documentId": "d1", "entry": "raffle" },
      "document": { "kind": "ok", "entryPoints": [] },
      "expected": { "show": "document", "entry": null, "report": "entryMissing" }
    },
    {
      "name": "the document is gone (404 after the document's own fallbacks)",
      "resolution": { "status": "document", "documentId": "d1", "entry": "raffle" },
      "document": { "kind": "missing" },
      "expected": { "show": "nothing", "entry": null, "report": "documentMissing" }
    },
    {
      "name": "the document is gone, no entry asked",
      "resolution": { "status": "document", "documentId": "d1", "entry": null },
      "document": { "kind": "missing" },
      "expected": { "show": "nothing", "entry": null, "report": "documentMissing" }
    },
    {
      "name": "the document cannot be read",
      "resolution": { "status": "document", "documentId": "d1", "entry": null },
      "document": { "kind": "unreadable" },
      "expected": { "show": "nothing", "entry": null, "report": "documentUnreadable" }
    },
    {
      "name": "an empty placement draws nothing and tells the host",
      "resolution": { "status": "empty", "documentId": null, "entry": null },
      "expected": { "show": "nothing", "entry": null, "report": "empty" }
    },
    {
      "name": "an unknown placement draws nothing and tells the host",
      "resolution": { "status": "unknown", "documentId": null, "entry": null },
      "expected": { "show": "nothing", "entry": null, "report": "unknown" }
    },
    {
      "name": "an unreadable placement draws nothing and tells the host",
      "resolution": { "status": "unreadable", "documentId": null, "entry": null },
      "expected": { "show": "nothing", "entry": null, "report": "unreadable" }
    }
