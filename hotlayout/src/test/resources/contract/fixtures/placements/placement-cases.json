      "publishable": true,
      "read": "map",
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d1", "entry": "spring" }]
    },
    {
      "name": "another major (newer) is not understood",
      "json": { "placementsVersion": "2.0.0", "placements": { "home.banner": { "documentId": "d1" } } },
      "publishable": true,
      "read": "unsupported",
      "resolve": [{ "name": "home.banner", "status": "unreadable", "documentId": null, "entry": null }]
    },
    {
