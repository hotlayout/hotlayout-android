{
  "about": "Shared case table for the placement map (contract/placements.json). Every reader runs every row. readCases: reading the map file and resolving names against it; publishable says whether the strict schema accepts the file (a builder publishes only such files), read and resolve are what a tolerant reader does. sourceCases: which map a reader uses (network, last known, bundled) and with which status. showingCases: what a placement draws once its document has been loaded. Limits on the number of placements and on file size are publish-side only and are not rows here.",
  "placementsVersion": "1.0.0",
  "readCases": [
    {
      "name": "full map: a document with an entry, a document without one, an empty placement",
      "json": {
        "placementsVersion": "1.0.0",
        "placements": {
          "home.banner": { "documentId": "d-raffle", "entry": "raffle" },
          "promo.raffle-button": { "documentId": "d-raffle" },
          "profile.top": { "documentId": null }
        }
      },
      "publishable": true,
      "read": "map",
      "resolve": [
        { "name": "home.banner", "status": "document", "documentId": "d-raffle", "entry": "raffle" },
        { "name": "promo.raffle-button", "status": "document", "documentId": "d-raffle", "entry": null },
        { "name": "profile.top", "status": "empty", "documentId": null, "entry": null },
        { "name": "cart.banner", "status": "unknown", "documentId": null, "entry": null },
        { "name": "Home.Banner", "status": "unknown", "documentId": null, "entry": null },
        { "name": " home.banner", "status": "unknown", "documentId": null, "entry": null },
        { "name": "constructor", "status": "unknown", "documentId": null, "entry": null },
        { "name": "__proto__", "status": "unknown", "documentId": null, "entry": null },
        { "name": "", "status": "unknown", "documentId": null, "entry": null }
      ]
    },
    {
      "name": "no placements at all",
      "json": { "placementsVersion": "1.0.0", "placements": {} },
      "publishable": true,
      "read": "map",
      "resolve": [{ "name": "home.banner", "status": "unknown", "documentId": null, "entry": null }]
    },
    {
      "name": "publishedAt in UTC is part of the published form",
      "json": { "placementsVersion": "1.0.0", "publishedAt": "2026-10-23T09:15:00.000Z", "placements": { "home.banner": { "documentId": "d1" } } },
      "publishable": true,
      "read": "map",
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d1", "entry": null }]
    },
    {
      "name": "malformed publishedAt: not publishable, but a reader does not look at it",
      "json": { "placementsVersion": "1.0.0", "publishedAt": "yesterday", "placements": { "home.banner": { "documentId": "d1" } } },
      "publishable": false,
      "read": "map",
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d1", "entry": null }]
    },
    {
      "name": "unknown top-level field: not publishable, ignored by a reader",
      "json": { "placementsVersion": "1.0.0", "owner": "marketing", "placements": { "home.banner": { "documentId": "d1" } } },
      "publishable": false,
      "read": "map",
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d1", "entry": null }]
    },
    {
      "name": "unknown field in a placement: not publishable, ignored by a reader",
      "json": { "placementsVersion": "1.0.0", "placements": { "home.banner": { "documentId": "d1", "from": "2026-11-01T00:00:00Z" } } },
      "publishable": false,
      "read": "map",
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d1", "entry": null }]
    },
    {
      "name": "newer minor of the same major is read",
