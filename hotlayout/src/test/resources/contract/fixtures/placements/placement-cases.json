  "sourceCases": [
    {
      "name": "a readable map from the network is used and remembered",
      "network": { "kind": "map", "text": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-new\"}}}" },
      "expected": { "source": "network", "status": "fresh", "remember": true },
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d-new", "entry": null }]
    },
    {
      "name": "the network wins over the last known map",
      "network": { "kind": "map", "text": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-new\"}}}" },
      "lastKnown": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-old\"}}}",
      "bundled": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-bundled\"}}}",
      "expected": { "source": "network", "status": "fresh", "remember": true },
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d-new", "entry": null }]
    },
    {
      "name": "a fresh map without the placement is the answer: no fallback to an older map",
      "network": { "kind": "map", "text": "{\"placementsVersion\":\"1.0.0\",\"placements\":{}}" },
      "lastKnown": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-old\"}}}",
      "expected": { "source": "network", "status": "fresh", "remember": true },
      "resolve": [{ "name": "home.banner", "status": "unknown", "documentId": null, "entry": null }]
    },
    {
      "name": "a broken placement in a fresh map is unreadable; no fallback for one placement",
      "network": { "kind": "map", "text": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"../x\"},\"home.ok\":{\"documentId\":\"d1\"}}}" },
      "lastKnown": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-old\"}}}",
      "expected": { "source": "network", "status": "fresh", "remember": true },
      "resolve": [
        { "name": "home.banner", "status": "unreadable", "documentId": null, "entry": null },
        { "name": "home.ok", "status": "document", "documentId": "d1", "entry": null }
      ]
    },
    {
      "name": "304 Not Modified keeps the last known map, and it is fresh",
      "network": { "kind": "notModified" },
      "lastKnown": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-old\"}}}",
      "bundled": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-bundled\"}}}",
      "expected": { "source": "lastKnown", "status": "fresh", "remember": false },
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d-old", "entry": null }]
    },
    {
      "name": "304 without a last known map counts as no answer",
      "network": { "kind": "notModified" },
      "bundled": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-bundled\"}}}",
      "expected": { "source": "bundled", "status": "offline", "remember": false },
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d-bundled", "entry": null }]
    },
    {
      "name": "304 with an unreadable last known map and nothing bundled",
      "network": { "kind": "notModified" },
      "lastKnown": "garbage",
      "expected": { "source": "none", "status": "offline", "remember": false },
      "resolve": [{ "name": "home.banner", "status": "unreadable", "documentId": null, "entry": null }]
    },
    {
      "name": "no answer: the last known map first",
      "network": { "kind": "offline" },
      "lastKnown": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-old\"}}}",
      "bundled": "{\"placementsVersion\":\"1.0.0\",\"placements\":{\"home.banner\":{\"documentId\":\"d-bundled\"}}}",
      "expected": { "source": "lastKnown", "status": "offline", "remember": false },
      "resolve": [{ "name": "home.banner", "status": "document", "documentId": "d-old", "entry": null }]
    },
    {
      "name": "no answer and no last known map: the bundled copy",
      "network": { "kind": "offline" },
