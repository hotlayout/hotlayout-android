{
  "schemaVersion": "9.16.0",
  "documentId": "app-bar",
  "name": "App bar from the mock-up and own drawing sizes",
  "initialScreenId": "challenges",
  "screens": [
    {
      "screenId": "challenges",
      "name": "Challenges — the mock-up",
      "root": {
        "id": "challenges-root",
        "type": "Screen",
        "props": {
          "gap": "md"
        },
        "style": {
          "padding": "md",
          "background": {
            "kind": "color",
            "color": "border"
          }
        },
        "children": [
          {
            "id": "ch-bar",
            "type": "AppBar",
            "props": {
              "title": {
                "kind": "literal",
                "value": "Challenges"
              },
              "showBack": true,
              "titleAlign": "start"
            },
            "style": {
              "padding": {
                "top": "sm",
                "bottom": "sm"
              }
            },
            "children": [
              {
                "id": "ch-help",
                "type": "IconButton",
                "props": {
                  "icon": "circle-help",
                  "label": {
                    "kind": "literal",
                    "value": "Help"
                  },
                  "variant": "secondary",
                  "size": "md",
                  "action": {
                    "type": "none"
                  },
                  "glyphSize": 28
                },
                "style": {
                  "width": 48,
                  "height": 48
                }
              },
              {
                "id": "ch-exit",
                "type": "Button",
                "props": {
                  "label": {
                    "kind": "literal",
                    "value": "Exit"
                  },
                  "variant": "ghost",
                  "action": {
                    "type": "navigate.back"
                  },
                  "fullWidth": false,
                  "icon": "chevron-left",
                  "iconPosition": "start",
                  "size": "sm"
                },
                "zone": "leading",
                "style": {
                  "background": {
                    "kind": "color",
                    "color": "surface"
                  },
                  "radius": "pill",
                  "shadow": "low",
                  "color": "onSurface"
                }
              }
