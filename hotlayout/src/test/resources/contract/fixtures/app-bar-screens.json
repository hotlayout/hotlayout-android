          },
          {
            "id": "ch-lead",
            "type": "Text",
            "props": {
              "content": {
                "kind": "literal",
                "value": "The bar above is assembled from the mock-up: an own button in the leading zone, the title right after it, a round action with a drawing of 28."
              },
              "align": "start",
              "overflow": "ellipsis"
            },
            "style": {
              "color": "muted"
            }
          },
          {
            "id": "ch-next",
            "type": "Button",
            "props": {
              "label": {
                "kind": "literal",
                "value": "Centred title, two actions"
