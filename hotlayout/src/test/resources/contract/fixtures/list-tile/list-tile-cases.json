    { "name": "side out of range — default tile", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "size": 20 } }, "glyph": { "inline": 18, "block": 24 }, "expected": { "inline": 40, "block": 40, "glyphInline": 11, "glyphBlock": 8 } },
    { "name": "tile without a colour is no tile", "leading": { "kind": "icon", "icon": "gift", "tile": { "size": 48 } }, "glyph": { "inline": 18, "block": 24 }, "expected": { "inline": 18, "block": 24, "glyphInline": 0, "glyphBlock": 0 } },
    { "name": "a glyph larger than the tile is clipped: negative offsets", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "size": 24 } }, "glyph": { "inline": 30, "block": 40 }, "expected": { "inline": 24, "block": 24, "glyphInline": -3, "glyphBlock": -8 } },
    { "name": "system font scale 2: the glyph grows, the tile does not", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary" } }, "glyph": { "inline": 36, "block": 48 }, "expected": { "inline": 40, "block": 40, "glyphInline": 2, "glyphBlock": -4 } }
