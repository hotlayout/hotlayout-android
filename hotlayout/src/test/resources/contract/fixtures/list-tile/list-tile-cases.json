{
  "description": "Parts of a list row (ListTile), contract 9.19.0: line limits of the title and subtitle, the tile under the leading icon, the column of the trailing part with a caption, who is drawn in which colour and typography, the three columns of the row in both directions. Written by hand; numbers are logical pixels. Data — «x-style.layout.listTileParts» and «x-style.layout.partStyle». Readers run every row against their own implementation. «null» in an expectation means «absent».",
  "lineCases": [
    { "name": "three natural lines cut to one", "natural": 3, "limit": 1, "expected": { "lines": 1, "cut": true } },
    { "name": "one line under a limit of one is not cut", "natural": 1, "limit": 1, "expected": { "lines": 1, "cut": false } },
    { "name": "two lines exactly at the limit", "natural": 2, "limit": 2, "expected": { "lines": 2, "cut": false } },
    { "name": "three lines cut to two", "natural": 3, "limit": 2, "expected": { "lines": 2, "cut": true } },
    { "name": "no field — wraps without a limit", "natural": 3, "limit": null, "expected": { "lines": 3, "cut": false } },
    { "name": "seven lines cut to the largest limit", "natural": 7, "limit": 5, "expected": { "lines": 5, "cut": true } },
    { "name": "zero is out of range — no limit", "natural": 3, "limit": 0, "expected": { "lines": 3, "cut": false } },
    { "name": "six is out of range — no limit", "natural": 7, "limit": 6, "expected": { "lines": 7, "cut": false } },
    { "name": "a fraction is not a limit", "natural": 3, "limit": 1.5, "expected": { "lines": 3, "cut": false } },
    { "name": "a string is not a limit", "natural": 3, "limit": "2", "expected": { "lines": 3, "cut": false } }
  ],
  "tileCases": [
