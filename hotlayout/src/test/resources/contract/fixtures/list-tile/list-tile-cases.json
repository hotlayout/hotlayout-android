    { "name": "320, LTR: tile of 48, title in two lines, caption", "rowInline": 256, "gap": 8, "direction": "ltr", "leading": { "inline": 48, "block": 48 }, "bodyBlock": 48, "trailing": { "inline": 70, "block": 36 }, "expected": { "block": 48, "leading": { "x": 0, "y": 0, "width": 48, "height": 48 }, "body": { "x": 56, "y": 0, "width": 122, "height": 48 }, "trailing": { "x": 186, "y": 6, "width": 70, "height": 36 } } },
    { "name": "one line of text beside a caption: the trailing column is the tallest", "rowInline": 256, "gap": 8, "direction": "ltr", "leading": null, "bodyBlock": 24, "trailing": { "inline": 84, "block": 36 }, "expected": { "block": 36, "leading": null, "body": { "x": 0, "y": 6, "width": 164, "height": 24 }, "trailing": { "x": 172, "y": 0, "width": 84, "height": 36 } } },
