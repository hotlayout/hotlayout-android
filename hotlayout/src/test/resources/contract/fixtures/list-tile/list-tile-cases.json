    { "name": "tinted token, circle, own side", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": { "token": "primary", "opacity": 0.1 }, "radius": "pill", "size": 48 } }, "expected": { "color": { "token": "primary", "opacity": 0.1 }, "radius": "pill", "size": 48 } },
    { "name": "own colour and a radius in pixels", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": { "value": "#ff7a59" }, "radius": 12 } }, "expected": { "color": { "value": "#ff7a59" }, "radius": 12, "size": 40 } },
    { "name": "negative radius — default", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "radius": -1 } }, "expected": { "color": "primary", "radius": "sm", "size": 40 } },
    { "name": "radius over the limit — default", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "radius": 300 } }, "expected": { "color": "primary", "radius": "sm", "size": 40 } },
    { "name": "side over the limit — default", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "size": 97 } }, "expected": { "color": "primary", "radius": "sm", "size": 40 } },
    { "name": "side under the limit — default", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "size": 23 } }, "expected": { "color": "primary", "radius": "sm", "size": 40 } },
    { "name": "side as a string — default", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "size": "48" } }, "expected": { "color": "primary", "radius": "sm", "size": 40 } },
    { "name": "the smallest and the largest side are kept", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary", "size": 96 } }, "expected": { "color": "primary", "radius": "sm", "size": 96 } },
    { "name": "no colour — no tile", "leading": { "kind": "icon", "icon": "gift", "tile": { "radius": "pill" } }, "expected": null },
    { "name": "colour of the wrong form — no tile", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "#FFF" } }, "expected": null },
    { "name": "no field — no tile", "leading": { "kind": "icon", "icon": "gift" }, "expected": null },
    { "name": "a tile is read only under an icon", "leading": { "kind": "none", "tile": { "color": "primary" } }, "expected": null }
  ],
  "leadingBoxCases": [
