    { "name": "default tile — glyph in the centre", "leading": { "kind": "icon", "icon": "gift", "tile": { "color": "primary" } }, "glyph": { "inline": 18, "block": 24 }, "expected": { "inline": 40, "block": 40, "glyphInline": 11, "glyphBlock": 8 } },
