  "ruleCases": [
    {
      "name": "the collapse lasts 600 ms",
      "rule": "collapse.durationMs",
      "expect": 600
    },
    {
      "name": "the curve of the collapse is fastOutSlowIn",
      "rule": "collapse.curve",
      "expect": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    {
      "name": "the halo is the fill at 0.4",
      "rule": "collapse.haloOpacity",
      "expect": 0.4
    },
    {
      "name": "the ripple lasts 800 ms",
      "rule": "ripple.durationMs",
      "expect": 800
    },
    {
      "name": "the ripple is linear",
      "rule": "ripple.curve",
      "expect": "linear"
    },
    {
      "name": "the reveal lasts 200 ms",
      "rule": "reveal.durationMs",
      "expect": 200
    },
    {
      "name": "the ripple plays on these actions",
      "rule": "ripple.actions",
      "expect": [
        "navigate",
        "navigate.back"
      ]
    },
    {
      "name": "the field",
      "rule": "field",
      "expect": "confirmTransition"
    },
    {
      "name": "its one word",
      "rule": "words",
      "expect": [
        "ripple"
      ]
    },
    {
      "name": "the thumb radius is concentric with the track",
      "rule": "thumbShape.radius",
      "expect": "the-track-radius-minus-the-inset-never-below-zero-concentric-with-the-track"
    },
    {
      "name": "the inset is read from the 9.22 block, not copied",
      "rule": "thumbShape.inset",
      "expect": "x-swipeConfirm.thumb.inset"
    },
    {
      "name": "the fill behind the thumb has the thumb radius on every corner",
      "rule": "thumbShape.trail",
      "expect": "the-radius-of-the-thumb-on-every-corner-no-corner-sticks-out"
    }
  ]
}
