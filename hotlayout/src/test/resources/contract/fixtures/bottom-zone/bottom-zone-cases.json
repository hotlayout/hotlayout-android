{
  "description": "The bottom zone of a screen (schema 9.12.0): a block pinned to the bottom and the navigation bar. Cases shared by every reader of the contract, written by hand. `childrenCases`: which child of the screen root stands in which zone — `children` are the children of the root in document order (`pin` is the raw value of the field, anything may stand there), `expect` names them by id; `body` is everything that scrolls. Document order counts, not visibility: a hidden node has no zone, and no other node takes its place. `pinCases`: how the field `pin` is read. `zoneCases`: geometry of the zones in screen coordinates from the top of the screen, in logical pixels — the input is what a reader knows after measuring (`appBarHeight`, `pinnedHeight`, `navBarHeight` are absent when that node is absent, hidden or not drawn; `bodyContentHeight` is absent when the body has no visible children), `shrink` is a modal layer as tall as its content. The bottom zone from top to bottom: the pinned block, the bottom padding of the root under it, the navigation bar, the safe inset; the background of the bar reaches the physical bottom, so `navBar.height` includes the inset and `navBar.contentHeight` does not. With a pinned block the body ends with the gap of the screen instead of the bottom padding of the root. `navHeightCases`: the height of the bar from theme numbers. `navShareCases`: the shares of the items — `start` from the LEFT edge of the bar; a hidden item has no share (`null`); only the first five visible items are drawn. `activeCases`: which item is active on the shown screen. `sectionCases`: the stack after `navigate.section` — `null` means nothing happens and no screen-shown event is sent. `ruleCases`: a key of `x-style.layout.bottomZone` or `x-style.layout.navBar` and its value. `documentCases`: documents and what the validator of the builder says (`sentences` are keys of its messages; a reader does not need them, but the rows show which documents the builder never publishes). Flows of switching sections live in `flowCases` of `contract/fixtures/actions/action-cases.json` (rows named `9.12 sections: …`).",

  "childrenCases": [
    { "name": "no bottom zone: every child but the app bar is the body", "children": [{ "id": "bar", "type": "AppBar" }, { "id": "a", "type": "Text" }, { "id": "b", "type": "Button" }], "expect": { "appBar": "bar", "body": ["a", "b"], "pinned": null, "navBar": null } },
    { "name": "the navigation bar is the last child of the root", "children": [{ "id": "bar", "type": "AppBar" }, { "id": "a", "type": "Text" }, { "id": "nav", "type": "NavBar" }], "expect": { "appBar": "bar", "body": ["a"], "pinned": null, "navBar": "nav" } },
    { "name": "a navigation bar that is not last is an ordinary child of the body", "children": [{ "id": "nav", "type": "NavBar" }, { "id": "a", "type": "Text" }], "expect": { "appBar": null, "body": ["nav", "a"], "pinned": null, "navBar": null } },
    { "name": "two navigation bars: only the last one is the zone, the other stays in the body", "children": [{ "id": "a", "type": "Text" }, { "id": "nav-1", "type": "NavBar" }, { "id": "nav-2", "type": "NavBar" }], "expect": { "appBar": null, "body": ["a", "nav-1"], "pinned": null, "navBar": "nav-2" } },
    { "name": "the pinned block is the last child with pin: bottom", "children": [{ "id": "a", "type": "Text" }, { "id": "cta", "type": "Button", "pin": "bottom" }], "expect": { "appBar": null, "body": ["a"], "pinned": "cta", "navBar": null } },
    { "name": "both: the pinned block is the last child not counting the navigation bar", "children": [{ "id": "bar", "type": "AppBar" }, { "id": "a", "type": "Text" }, { "id": "cta", "type": "Container", "pin": "bottom" }, { "id": "nav", "type": "NavBar" }], "expect": { "appBar": "bar", "body": ["a"], "pinned": "cta", "navBar": "nav" } },
    { "name": "pin on a child that is not last is not read", "children": [{ "id": "cta", "type": "Button", "pin": "bottom" }, { "id": "a", "type": "Text" }], "expect": { "appBar": null, "body": ["cta", "a"], "pinned": null, "navBar": null } },
    { "name": "two children with pin: only the last one is pinned, the other scrolls with the body", "children": [{ "id": "a", "type": "Text" }, { "id": "cta-1", "type": "Button", "pin": "bottom" }, { "id": "cta-2", "type": "Button", "pin": "bottom" }], "expect": { "appBar": null, "body": ["a", "cta-1"], "pinned": "cta-2", "navBar": null } },
    { "name": "pin on the navigation bar means nothing: it is a zone already", "children": [{ "id": "a", "type": "Text" }, { "id": "nav", "type": "NavBar", "pin": "bottom" }], "expect": { "appBar": null, "body": ["a"], "pinned": null, "navBar": "nav" } },
    { "name": "the app bar is never pinned, even when it is the only child", "children": [{ "id": "bar", "type": "AppBar", "pin": "bottom" }], "expect": { "appBar": "bar", "body": [], "pinned": null, "navBar": null } },
    { "name": "an app bar that is not first is an ordinary child, so as the last child it can be pinned", "children": [{ "id": "a", "type": "Text" }, { "id": "bar", "type": "AppBar", "pin": "bottom" }], "expect": { "appBar": null, "body": ["a"], "pinned": "bar", "navBar": null } },
    { "name": "a word of pin the reader does not know: as if there were no field", "children": [{ "id": "a", "type": "Text" }, { "id": "cta", "type": "Button", "pin": "top" }], "expect": { "appBar": null, "body": ["a", "cta"], "pinned": null, "navBar": null }, "refinedIn": "9.24.0", "refinedNote": "From 9.24.0 «top» is a word of the contract; here it stands after a child without the word, so it is still not read (x-style.layout.topZone.run)." },
    { "name": "only a pinned block and a navigation bar: the body is empty", "children": [{ "id": "cta", "type": "Button", "pin": "bottom" }, { "id": "nav", "type": "NavBar" }], "expect": { "appBar": null, "body": [], "pinned": "cta", "navBar": "nav" } },
    { "name": "an empty root: nothing anywhere", "children": [], "expect": { "appBar": null, "body": [], "pinned": null, "navBar": null } }
  ],

  "pinCases": [
    { "name": "bottom", "pin": "bottom", "expect": "bottom" },
    { "name": "a word of a newer minor", "pin": "top", "expect": null, "refinedIn": "9.24.0", "refinedNote": "From 9.24.0 «top» is the word of the top zone (x-style.layout.topZone, contract/fixtures/top-zone/top-zone-cases.json). The bottom zone still does not read it: this row stays true for the bottom zone." },
    { "name": "true is not a word", "pin": true, "expect": null },
    { "name": "null", "pin": null, "expect": null },
    { "name": "a number", "pin": 1, "expect": null },
    { "name": "an object", "pin": { "edge": "bottom" }, "expect": null },
    { "name": "another case of the word", "pin": "Bottom", "expect": null },
    { "name": "the empty string", "pin": "", "expect": null }
  ],

