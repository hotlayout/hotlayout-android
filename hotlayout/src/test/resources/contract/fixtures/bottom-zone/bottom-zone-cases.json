    { "name": "— hidden by a condition, it has no zone", "block": "bottomZone", "rule": "navBar.hidden", "expect": "no-zone" },
    { "name": "— not last, it is an ordinary child of the body", "block": "bottomZone", "rule": "navBar.notLast", "expect": "ordinary-child-of-the-body" },
    { "name": "— on a screen shown as a modal layer it is not drawn", "block": "bottomZone", "rule": "navBar.inModalLayer", "expect": "not-drawn" },
    { "name": "the pinned block is named by a field of the node", "block": "bottomZone", "rule": "pinned.field", "expect": "pin" },
    { "name": "— at most one", "block": "bottomZone", "rule": "pinned.atMost", "expect": 1 },
    { "name": "— anywhere else the field is not read", "block": "bottomZone", "rule": "pinned.elsewhere", "expect": "field-is-not-read" },
    { "name": "— pull on the pinned node is not read", "block": "bottomZone", "rule": "pinned.pull", "expect": "not-read-on-the-pinned-node" },
    { "name": "— it has no background unless the node names one", "block": "bottomZone", "rule": "pinned.background", "expect": "none-unless-the-node-names-one" },
    { "name": "— in a modal layer it is drawn at the bottom of the layer", "block": "bottomZone", "rule": "pinned.inModalLayer", "expect": "drawn-at-the-bottom-of-the-layer" },
    { "name": "the pinned block gets the side and bottom paddings of the root", "block": "bottomZone", "rule": "padding.pinned", "expect": ["start", "end", "bottom"] },
    { "name": "— and the body ends with the gap of the screen instead", "block": "bottomZone", "rule": "padding.bodyBottomWithPinned", "expect": "screen-gap" },
    { "name": "— the navigation bar has no paddings of the root: edge to edge", "block": "bottomZone", "rule": "padding.navBar", "expect": "none" },
    { "name": "the body is clipped at the top edge of the zone", "block": "bottomZone", "rule": "bodyClip", "expect": "top-edge-of-the-bottom-zone" },
    { "name": "so nothing shows through a pinned block without a background but the background of the screen", "block": "bottomZone", "rule": "contentUnderBottomZone", "expect": "never" },
    { "name": "the reader adds the bottom safe inset itself — under the content of the zone", "block": "bottomZone", "rule": "safeArea.bottom", "expect": "reader-adds-the-platform-inset-under-the-content-of-the-bottom-zone" },
    { "name": "— the background of the bar reaches the physical bottom", "block": "bottomZone", "rule": "safeArea.navBarBackground", "expect": "extends-under-the-inset-to-the-physical-bottom" },
    { "name": "— a screen without a bottom zone gets nothing", "block": "bottomZone", "rule": "safeArea.withoutBottomZone", "expect": "reader-adds-nothing" },
    { "name": "— a host that accounted for the inset gives zero", "block": "bottomZone", "rule": "safeArea.host", "expect": "may-give-zero-when-it-accounted-for-the-inset-itself" },
    { "name": "the keyboard: the pinned block rides above it", "block": "bottomZone", "rule": "keyboard.pinned", "expect": "rides-above-the-keyboard" },
    { "name": "— the navigation bar stays under it", "block": "bottomZone", "rule": "keyboard.navBar", "expect": "covered-by-the-keyboard" },
    { "name": "a web block without its own height: the same switch of the host as for the app bar", "block": "bottomZone", "rule": "withoutOwnHeight.decides", "expect": "host-the-same-switch-as-the-app-bar" },
    { "name": "— by default the zone sticks to the bottom of what scrolls", "block": "bottomZone", "rule": "withoutOwnHeight.default", "expect": "bottom-zone-sticks-to-the-bottom-of-the-scrolling-ancestor" },
    { "name": "— a stuck pinned block paints the background of the screen root under itself", "block": "bottomZone", "rule": "withoutOwnHeight.stuckBackdrop", "expect": "screen-root-background-under-the-pinned-block" },
    { "name": "the values of pin", "block": "bottomZone", "rule": "pinValues", "expect": ["bottom"] },
    { "name": "the bar: items in document order, equal shares", "block": "navBar", "rule": "items.width", "expect": "equal-shares-of-the-bar-width-among-visible-items" },
    { "name": "— at most five", "block": "navBar", "rule": "items.max", "expect": 5 },
    { "name": "— fewer than two are drawn as they are", "block": "navBar", "rule": "items.fewer", "expect": "drawn-as-is" },
    { "name": "— the first item at the start of the reading direction", "block": "navBar", "rule": "items.order", "expect": "reading-direction-first-item-at-the-inline-start" },
    { "name": "an item: the icon above the label", "block": "navBar", "rule": "item.direction", "expect": "icon-above-label" },
    { "name": "— paddings and the gap are steps of the theme", "block": "navBar", "rule": "item.paddingBlock", "expect": "sm" },
    { "name": "— the icon is the md step", "block": "navBar", "rule": "item.iconSize", "expect": "md" },
    { "name": "— the label is bodyS, one line, cut with an ellipsis", "block": "navBar", "rule": "item.labelOverflow", "expect": "ellipsis" },
    { "name": "— the whole share is the touch area", "block": "navBar", "rule": "item.touchArea", "expect": "the-whole-share-at-the-full-height-of-the-bar" },
    { "name": "the built-in look: the surface colour", "block": "navBar", "rule": "surface.background", "expect": "surface" },
    { "name": "— a top line of one pixel in the border colour", "block": "navBar", "rule": "surface.borderTop", "expect": { "width": 1, "color": "border" } },
    { "name": "the active item is primary, the rest muted", "block": "navBar", "rule": "color", "expect": { "active": "primary", "inactive": "muted", "named": "inherited-color-active-as-is-inactive-at-secondary-opacity", "icon": "same-as-the-label" } },
    { "name": "which item is active", "block": "navBar", "rule": "active.is", "expect": "item-whose-action-is-navigate.section-to-the-shown-screen" },
    { "name": "pressing the active item does nothing", "block": "navBar", "rule": "press.activeItem", "expect": "nothing-happens-no-event" },
    { "name": "the bar is a navigation landmark, an item is a button, the active one is the current page", "block": "navBar", "rule": "semantics", "expect": { "bar": "navigation", "item": "button", "name": "label", "active": "current-page", "keyboard": "every-item-is-a-tab-stop-enter-and-space-press" } },
    { "name": "no counter badge on an item in 9.12", "block": "navBar", "rule": "badge", "expect": "none-in-9.12" }
