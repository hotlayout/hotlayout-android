  "navBadgeNote": "9.22.0 — the dot on a navigation item («NavItem.badgeWhen», «x-style.layout.navBadge»). «data» is the value under the path; a row without «data» has no value at all (the missing-data rule of «x-conditions»: only «isEmpty» holds). The box of the dot is in item coordinates, from the LEFT edge: its centre is on the top corner of the glyph at the end of the line.",
  "navBadgeCases": [
    { "name": "no field — no dot", "props": {}, "data": { "user.unread": 3 }, "expect": false },
    { "name": "«gt 0» with 3 unread — a dot", "props": { "badgeWhen": { "path": "user.unread", "op": "gt", "value": 0 } }, "data": { "user.unread": 3 }, "expect": true },
    { "name": "«gt 0» with 0 unread — no dot", "props": { "badgeWhen": { "path": "user.unread", "op": "gt", "value": 0 } }, "data": { "user.unread": 0 }, "expect": false },
    { "name": "«gt 0» without data — no dot: an order operator does not hold on a missing value", "props": { "badgeWhen": { "path": "user.unread", "op": "gt", "value": 0 } }, "expect": false },
    { "name": "«isNotEmpty» without data — no dot", "props": { "badgeWhen": { "path": "user.unread", "op": "isNotEmpty" } }, "expect": false },
    { "name": "«isEmpty» without data — a dot: the same rule as visibleIf", "props": { "badgeWhen": { "path": "user.unread", "op": "isEmpty" } }, "expect": true },
    { "name": "«isTrue» on a flag that is true — a dot", "props": { "badgeWhen": { "path": "user.hasNews", "op": "isTrue" } }, "data": { "user.hasNews": true }, "expect": true },
    { "name": "an operator of a newer minor — no dot (visibleIf would show the node; a dot nobody asked for is the worse mistake)", "props": { "badgeWhen": { "path": "user.unread", "op": "between", "value": 1 } }, "data": { "user.unread": 3 }, "expect": false },
    { "name": "a condition that is not an object — no dot", "props": { "badgeWhen": "user.unread" }, "data": { "user.unread": 3 }, "expect": false }
  ],
  "navBadgeBoxCases": [
    { "name": "a 24 glyph 30 from the left, 3 from the top, left to right: the centre on its top right corner", "glyph": { "left": 30, "top": 3, "size": 24 }, "rtl": false, "expect": { "left": 50, "top": -1, "size": 8 } },
    { "name": "the same right to left: the centre on its top left corner", "glyph": { "left": 30, "top": 3, "size": 24 }, "rtl": true, "expect": { "left": 26, "top": -1, "size": 8 } },
