  "navBadgeMotionNote": "Schema 9.24.0, rules: x-style.layout.navBadgeMotion. The dot appears with a short flash and disappears by fading when its condition changes its answer on a shown screen. «navBadgeMotionCases» — whether the dot moves. «navBadgeAppearScaleCases» — the scale of the dot at t milliseconds of the appearance. «navBadgeDisappearOpacityCases» — its opacity at t milliseconds of the fading. Compare numbers with a tolerance of 1e-9.",
  "navBadgeMotionCases": [
    { "name": "the first show with the dot: no flash", "input": { "shownBefore": false, "before": false, "after": true }, "expect": "none" },
    { "name": "the condition becomes true on a shown screen: the flash", "input": { "shownBefore": true, "before": false, "after": true }, "expect": "appear" },
    { "name": "the condition becomes false: the dot fades", "input": { "shownBefore": true, "before": true, "after": false }, "expect": "disappear" },
    { "name": "the same answer: nothing moves", "input": { "shownBefore": true, "before": true, "after": true }, "expect": "none" },
    { "name": "reduce motion: the dot appears at once", "input": { "shownBefore": true, "before": false, "after": true, "reducedMotion": true }, "expect": "none" },
    { "name": "reduce motion: the dot disappears at once", "input": { "shownBefore": true, "before": true, "after": false, "reducedMotion": true }, "expect": "none" }
  ],
  "navBadgeAppearScaleCases": [
