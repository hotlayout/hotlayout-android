  "floatZoneNote": "9.22.0 — the floating bar («NavBar.float: true», «x-style.layout.navFloat»). Every row is screenZonesOf with «navFloat»: the body area reaches the bottom of the screen, the content gets the height of the bottom zone as an extra tail, the bar box has no safe inset (it lies under the bar, outside it). The zone arithmetic is vertical: right-to-left scripts give the same numbers. Rows without a bar in the zone or with «navFloat» false are exactly screenZonesOf.",
  "floatZoneCases": [
    { "name": "568, an app bar, long content, a floating bar of 61, no inset: the body reaches the bottom, the tail is the zone", "height": 568, "appBarHeight": 56, "padding": { "top": 16, "bottom": 16 }, "gap": 12, "bodyContentHeight": 600, "navFloat": true, "bottom": { "navBarHeight": 61 }, "expect": { "height": 568, "appBar": { "top": 16, "height": 56 }, "body": { "top": 72, "height": 496 }, "contentTop": 84, "contentHeight": 689, "maxScroll": 193, "scrollTop": 0, "scrolls": true, "bottom": { "top": 507, "height": 61, "pinned": null, "navBar": { "top": 507, "height": 61, "contentHeight": 61 }, "safeBottom": 0 }, "float": true } },
    { "name": "the same with a 34 safe inset: the pill hangs 34 above the bottom, its box does not take the inset", "height": 568, "appBarHeight": 56, "padding": { "top": 16, "bottom": 16 }, "gap": 12, "bodyContentHeight": 600, "navFloat": true, "bottom": { "navBarHeight": 61, "safeBottom": 34 }, "expect": { "height": 568, "appBar": { "top": 16, "height": 56 }, "body": { "top": 72, "height": 496 }, "contentTop": 84, "contentHeight": 723, "maxScroll": 227, "scrollTop": 0, "scrolls": true, "bottom": { "top": 473, "height": 95, "pinned": null, "navBar": { "top": 473, "height": 61, "contentHeight": 61 }, "safeBottom": 34 }, "float": true } },
    { "name": "the same scrolled past the end: the scroll is clamped to the same limit as without the field", "height": 568, "appBarHeight": 56, "padding": { "top": 16, "bottom": 16 }, "gap": 12, "bodyContentHeight": 600, "navFloat": true, "scrollTop": 1000, "bottom": { "navBarHeight": 61, "safeBottom": 34 }, "expect": { "height": 568, "appBar": { "top": 16, "height": 56 }, "body": { "top": 72, "height": 496 }, "contentTop": -143, "contentHeight": 723, "maxScroll": 227, "scrollTop": 227, "scrolls": true, "bottom": { "top": 473, "height": 95, "pinned": null, "navBar": { "top": 473, "height": 61, "contentHeight": 61 }, "safeBottom": 34 }, "float": true } },
    { "name": "a pinned block of 48 over a floating bar, a 34 inset: the whole zone floats, the block stands above the pill, the body ends with the screen gap plus the zone", "height": 568, "appBarHeight": 56, "padding": { "top": 16, "bottom": 16 }, "gap": 12, "bodyContentHeight": 600, "navFloat": true, "bottom": { "pinnedHeight": 48, "navBarHeight": 61, "safeBottom": 34 }, "expect": { "height": 568, "appBar": { "top": 16, "height": 56 }, "body": { "top": 72, "height": 496 }, "contentTop": 84, "contentHeight": 783, "maxScroll": 287, "scrollTop": 0, "scrolls": true, "bottom": { "top": 409, "height": 159, "pinned": { "top": 409, "height": 48 }, "navBar": { "top": 473, "height": 61, "contentHeight": 61 }, "safeBottom": 34 }, "float": true } },
    { "name": "short content under a floating bar: the tail still fits, nothing scrolls", "height": 568, "appBarHeight": 56, "padding": { "top": 16, "bottom": 16 }, "gap": 12, "bodyContentHeight": 200, "navFloat": true, "bottom": { "navBarHeight": 61 }, "expect": { "height": 568, "appBar": { "top": 16, "height": 56 }, "body": { "top": 72, "height": 496 }, "contentTop": 84, "contentHeight": 289, "maxScroll": 0, "scrollTop": 0, "scrolls": false, "bottom": { "top": 507, "height": 61, "pinned": null, "navBar": { "top": 507, "height": 61, "contentHeight": 61 }, "safeBottom": 0 }, "float": true } },
    { "name": "no app bar, a floating bar and a 34 inset: the body is the whole screen, its top padding is inside the scroll", "height": 568, "padding": { "top": 16, "bottom": 16 }, "gap": 12, "bodyContentHeight": 600, "navFloat": true, "bottom": { "navBarHeight": 61, "safeBottom": 34 }, "expect": { "height": 568, "appBar": null, "body": { "top": 0, "height": 568 }, "contentTop": 16, "contentHeight": 727, "maxScroll": 159, "scrollTop": 0, "scrolls": true, "bottom": { "top": 473, "height": 95, "pinned": null, "navBar": { "top": 473, "height": 61, "contentHeight": 61 }, "safeBottom": 34 }, "float": true } },
