    { "name": "an empty path: no path", "type": "Row", "props": { "scrollable": true, "carousel": { "stopPath": "" } }, "readerOnly": true, "expect": null },
    { "name": "a path that is not a string: no path", "type": "Row", "props": { "scrollable": true, "carousel": { "stopPath": 7 } }, "readerOnly": true, "expect": null },
    { "name": "a path longer than 128 characters: no path", "type": "Row", "props": { "scrollable": true, "carousel": { "stopPath": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }, "readerOnly": true, "expect": null },
    { "name": "an unreadable carousel (not an object): no carousel, no path", "type": "Row", "props": { "scrollable": true, "carousel": "account.cardIndex" }, "readerOnly": true, "expect": null }
