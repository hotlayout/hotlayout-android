      "stack": { "width": 100, "height": 100 },
      "stackAlign": { "horizontal": "center", "vertical": "center" },
      "size": { "width": 60, "height": 20 },
      "layer": { "rotate": -90 },
      "ltr": { "rect": { "x": 20, "y": 40, "width": 60, "height": 20 }, "angle": -90, "taps": [{ "x": 50, "y": 22, "hits": true }, { "x": 30, "y": 50, "hits": false }] },
      "rtl": { "rect": { "x": 20, "y": 40, "width": 60, "height": 20 }, "angle": 90, "taps": [{ "x": 50, "y": 22, "hits": true }, { "x": 30, "y": 50, "hits": false }] },
      "protrudes": false
    },
    {
