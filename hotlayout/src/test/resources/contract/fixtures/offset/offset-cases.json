      "ltr": { "rect": { "x": 70, "y": 14, "width": 120, "height": 24 }, "angle": 45, "taps": [{ "x": 130, "y": 26, "hits": true }, { "x": 144, "y": 40, "hits": true }, { "x": 72, "y": 16, "hits": false }] },
      "rtl": { "rect": { "x": -30, "y": 14, "width": 120, "height": 24 }, "angle": -45, "taps": [{ "x": 30, "y": 26, "hits": true }, { "x": 16, "y": 40, "hits": true }, { "x": 88, "y": 16, "hits": false }] },
      "protrudes": true
    },
    {
