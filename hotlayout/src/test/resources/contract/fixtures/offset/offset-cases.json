      "stackAlign": { "horizontal": "center", "vertical": "center" },
      "size": { "width": 40, "height": 20 },
      "layer": {},
      "ltr": { "rect": { "x": 30, "y": 20, "width": 40, "height": 20 }, "angle": 0, "taps": [{ "x": 50, "y": 30, "hits": true }] },
      "rtl": { "rect": { "x": 30, "y": 20, "width": 40, "height": 20 }, "angle": 0, "taps": [{ "x": 50, "y": 30, "hits": true }] },
      "protrudes": false
    },
    {
