    { "name": "a value that is not an object: an ordinary layer that sizes the stack", "parent": "Stack", "children": [{}, { "layer": true }], "overlays": [false, false], "sizesStack": [true, true] },
    { "name": "every layer is an overlay — nothing sizes the stack: the field is read on none of them", "parent": "Stack", "children": [{ "layer": {} }, { "layer": { "alignHorizontal": "end" } }], "overlays": [false, false], "sizesStack": [true, true] },
    { "name": "overlays and stretched layers only: the field is not read; the stretched one stays stretched", "parent": "Stack", "children": [{ "fill": true }, { "layer": {} }], "overlays": [false, false], "sizesStack": [false, true] },
    { "name": "the layer that sizes the stack is hidden by a condition: the DOCUMENT is counted, not visibility — the overlay stays an overlay, and the stack has no size now", "parent": "Stack", "children": [{ "visibleIf": { "path": "user.isPremium", "op": "isTrue" } }, { "layer": { "alignHorizontal": "end" } }], "hidden": [true, false], "overlays": [false, true], "sizesStack": [true, false], "visibleSizers": 0 },
    { "name": "an overlay is hidden, the sizing layer is not: nothing changes for the one that is drawn", "parent": "Stack", "children": [{}, { "layer": {}, "visibleIf": { "path": "user.isPremium", "op": "isTrue" } }, { "layer": { "alignVertical": "end" } }], "hidden": [false, true, false], "overlays": [false, true, true], "sizesStack": [true, false, false], "visibleSizers": 1 }
  ],
