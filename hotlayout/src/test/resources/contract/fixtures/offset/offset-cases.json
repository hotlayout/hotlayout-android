{
  "description": "Overlay layers of a stack (`node.layer`) and pulled children of a flow (`node.pull`): cases shared by every reader of the contract (schema 9.10.0). Written by hand; numbers are logical pixels. `tokens` are the spacing steps of the built-in theme the rows use — a reader takes them from the theme, never from here. In `layerCases` a rectangle is the UNROTATED box of the layer after alignment and offset, in PHYSICAL coordinates of the stack box: `x` from its left edge, `y` from its top edge; `angle` is clockwise degrees about the centre of that box. The size of the stack is `stack` in every row, before and after: an overlay never changes it. `taps` are points in the same coordinates, all INSIDE the stack box: `hits` says whether the drawn layer is under the point. In `pullCases` `starts` are measured from the START of the content of the parent along its main axis (in a row — from the start of the LINE, so in RTL the physical x of a child is `size − start − child.size`). In `layerPlaceCases` the optional `hidden` says which children a condition hides NOW: who is an overlay and who sizes the stack is decided by the DOCUMENT and never by visibility (`visibleSizers` — how many of the sizing layers are drawn; zero means a stack of zero size with its overlays still placed as overlays).",
  "tokens": { "spacing": { "none": 0, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 } },
  "layerCases": [
    {
      "name": "a badge in the top-end corner of an icon: own alignment, no offset",
      "stack": { "width": 48, "height": 48 },
      "stackAlign": { "horizontal": "center", "vertical": "center" },
      "size": { "width": 20, "height": 16 },
      "layer": { "alignHorizontal": "end", "alignVertical": "start" },
      "ltr": { "rect": { "x": 28, "y": 0, "width": 20, "height": 16 }, "angle": 0, "taps": [{ "x": 38, "y": 8, "hits": true }, { "x": 10, "y": 8, "hits": false }] },
      "rtl": { "rect": { "x": 0, "y": 0, "width": 20, "height": 16 }, "angle": 0, "taps": [{ "x": 10, "y": 8, "hits": true }, { "x": 38, "y": 8, "hits": false }] },
      "protrudes": false
    },
    {
      "name": "the «×2» badge sticks out of the corner by `xs` on both axes; it is hit where it is drawn, not where it stood",
      "stack": { "width": 48, "height": 48 },
      "stackAlign": { "horizontal": "center", "vertical": "center" },
      "size": { "width": 20, "height": 16 },
      "layer": { "alignHorizontal": "end", "alignVertical": "start", "offset": { "x": { "toward": "end", "by": "xs" }, "y": { "toward": "top", "by": "xs" } } },
      "ltr": { "rect": { "x": 32, "y": -4, "width": 20, "height": 16 }, "angle": 0, "taps": [{ "x": 40, "y": 4, "hits": true }, { "x": 30, "y": 6, "hits": false }, { "x": 40, "y": 14, "hits": false }] },
      "rtl": { "rect": { "x": -4, "y": -4, "width": 20, "height": 16 }, "angle": 0, "taps": [{ "x": 8, "y": 4, "hits": true }, { "x": 18, "y": 6, "hits": false }] },
      "protrudes": true
    },
    {
      "name": "an offset in plain pixels: 6 towards the start, 10 down, from the top-start corner",
      "stack": { "width": 48, "height": 48 },
      "stackAlign": { "horizontal": "center", "vertical": "center" },
      "size": { "width": 20, "height": 16 },
      "layer": { "alignHorizontal": "start", "alignVertical": "start", "offset": { "x": { "toward": "start", "by": 6 }, "y": { "toward": "bottom", "by": 10 } } },
      "ltr": { "rect": { "x": -6, "y": 10, "width": 20, "height": 16 }, "angle": 0, "taps": [{ "x": 6, "y": 18, "hits": true }, { "x": 16, "y": 18, "hits": false }] },
      "rtl": { "rect": { "x": 34, "y": 10, "width": 20, "height": 16 }, "angle": 0, "taps": [{ "x": 42, "y": 18, "hits": true }] },
      "protrudes": true
    },
    {
      "name": "an empty `layer` is still an overlay: the alignment of the stack, no offset, no rotation",
