  "layerReadCases": [
    { "name": "an object with nothing in it: an overlay with the alignment of the stack", "value": {}, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "everything named", "value": { "alignHorizontal": "end", "alignVertical": "start", "offset": { "x": { "toward": "end", "by": "xs" }, "y": { "toward": "top", "by": 6 } }, "rotate": -12 }, "expect": { "alignHorizontal": "end", "alignVertical": "start", "offsetX": { "toward": "end", "by": "xs" }, "offsetY": { "toward": "top", "by": 6 }, "rotate": -12 } },
    { "name": "`true` is not a place: an ordinary layer", "value": true, "expect": null },
    { "name": "a word is not a place: an ordinary layer", "value": "end", "expect": null },
    { "name": "null: an ordinary layer", "value": null, "expect": null },
    { "name": "a list: an ordinary layer", "value": [], "expect": null },
    { "name": "a physical side is not an alignment word: the alignment of the stack; the other word stays", "value": { "alignHorizontal": "left", "alignVertical": "end" }, "expect": { "alignHorizontal": null, "alignVertical": "end", "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "an unknown direction on one axis drops that axis only", "value": { "offset": { "x": { "toward": "left", "by": 4 }, "y": { "toward": "top", "by": "xs" } } }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": { "toward": "top", "by": "xs" }, "rotate": 0 } },
    { "name": "`top` is not a word of the horizontal axis", "value": { "offset": { "x": { "toward": "top", "by": 4 } } }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "a negative amount is not a spacing: no offset on that axis (the direction is a word, not a sign)", "value": { "offset": { "x": { "toward": "end", "by": -4 } } }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "an amount above 128: no offset on that axis, not a clamp", "value": { "offset": { "y": { "toward": "bottom", "by": 200 } } }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "a fractional amount: no offset on that axis", "value": { "offset": { "y": { "toward": "bottom", "by": 4.5 } } }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "a CSS length is not a token name: no offset on that axis", "value": { "offset": { "x": { "toward": "end", "by": "4px" } } }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "an axis without an amount", "value": { "offset": { "x": { "toward": "end" } } }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "the 3.0 trap: a whole number written with a fraction is a whole number", "value": { "offset": { "x": { "toward": "end", "by": 3.0 } }, "rotate": 45.0 }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": { "toward": "end", "by": 3 }, "offsetY": null, "rotate": 45 } },
    { "name": "`offset` written as a bare token: no offset", "value": { "offset": "xs", "alignHorizontal": "end" }, "expect": { "alignHorizontal": "end", "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "a fractional angle: no rotation", "value": { "rotate": 45.5 }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "an angle outside −180…180: no rotation, not a wrap-around", "value": { "rotate": 270 }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "an angle written as a string: no rotation", "value": { "rotate": "45" }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": 0 } },
    { "name": "the edges of the range are angles", "value": { "rotate": -180 }, "expect": { "alignHorizontal": null, "alignVertical": null, "offsetX": null, "offsetY": null, "rotate": -180 } },
    { "name": "a key of a newer minor is skipped, the rest is read", "value": { "scale": 2, "alignVertical": "end" }, "expect": { "alignHorizontal": null, "alignVertical": "end", "offsetX": null, "offsetY": null, "rotate": 0 } }
  ],
  "layerPlaceCases": [
    { "name": "a direct child of a stack beside an ordinary layer: an overlay", "parent": "Stack", "children": [{}, { "layer": { "alignHorizontal": "end" } }], "overlays": [false, true], "sizesStack": [true, false] },
    { "name": "the first layer may be the overlay too: order is the paint order, not who sizes", "parent": "Stack", "children": [{ "layer": {} }, {}], "overlays": [true, false], "sizesStack": [false, true] },
