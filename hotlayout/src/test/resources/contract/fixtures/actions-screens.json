                      "align": "start",
                      "overflow": "visible"
                    },
                    "style": {
                      "color": "muted",
                      "typography": "bodyS"
                    }
                  },
                  {
                    "id": "open-terms",
                    "type": "Button",
                    "props": {
                      "label": {
                        "kind": "literal",
                        "value": "Open the terms"
                      },
                      "variant": "primary",
                      "action": {
                        "type": "openUrl",
                        "params": {
                          "url": "https://example.com/terms?utm_source=app"
                        },
                        "track": {
                          "event": "terms_open",
                          "params": {
                            "placement": "offer"
                          }
