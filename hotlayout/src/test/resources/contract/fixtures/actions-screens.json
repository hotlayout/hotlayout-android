            "props": {
              "gap": "sm",
              "align": "start"
            },
            "style": {
              "padding": "md"
            },
            "children": [
              {
                "id": "standard-card",
                "type": "Container",
                "props": {
                  "direction": "column",
                  "gap": "sm"
                },
                "style": {
                  "padding": "md",
                  "radius": "lg",
                  "background": {
                    "kind": "color",
                    "color": "surface"
                  },
