                  {
                    "id": "reward-list",
                    "type": "Repeater",
                    "props": {
                      "source": "items",
                      "item": "item",
                      "direction": "column",
                      "gap": "none"
                    },
                    "children": [
                      {
                        "id": "reward-row",
                        "type": "ListTile",
                        "props": {
                          "leading": {
                            "kind": "icon",
                            "icon": "star"
                          },
                          "title": {
                            "kind": "binding",
                            "path": "item.name",
                            "fallback": "Reward"
                          },
                          "trailing": {
                            "kind": "text",
                            "text": {
                              "kind": "binding",
                              "path": "item.price",
                              "fallback": "—"
                            }
                          },
                          "action": {
                            "type": "navigate",
                            "params": {
                              "screenId": "details"
                            },
                            "track": {
                              "event": "reward_open"
                            }
                          }
                        },
                        "style": {
                          "padding": {
                            "top": "sm",
                            "bottom": "sm"
                          }
                        }
                      }
                    ]
