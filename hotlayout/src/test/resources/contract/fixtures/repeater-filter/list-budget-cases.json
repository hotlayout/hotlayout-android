          { "id": "outer-row", "type": "Column", "props": {}, "children": [
            { "id": "inner", "type": "Repeater", "props": { "source": "items", "item": "item", "limit": 50 }, "children": [{ "id": "inner-row", "type": "Text", "props": { "content": { "kind": "literal", "value": "Row" } } }] }
          ] }
        ] }
      ],
      "worst": 2550,
