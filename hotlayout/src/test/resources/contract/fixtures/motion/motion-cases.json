{
  "description": "Motion of a node and blur under a layer (schema 9.20.0). Shared by every reader: the pose of a moving node at a moment, «reduce motion», the borders of every number, hostile values, and the blur fields of the screen entry and of the node style. Written by hand; numbers are exact at quarter turns of the phase. Poses are logical pixels (x to the right, y down), a scale and an opacity factor; compare with a tolerance of 1e-6.",
  "poseNote": "t is milliseconds since the node appeared. theta = 2 * pi * ((t - delay) mod duration) / duration; before the delay — rest. float: x = amplitude * sin(theta) toward the end of the line (mirrored right-to-left), y = -amplitude * sin(theta) for «vertical» and -amplitude * sin(2 * theta) for «both». pulse: p = (1 - cos(theta)) / 2, scale = 1 + (scale - 1) * p, opacity = 1 + (opacity - 1) * p.",
  "poseCases": [
    { "name": "float vertical, at the start — rest", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 0, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float vertical, a quarter — highest point, up first", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 1000, "expected": { "x": 0, "y": -8, "scale": 1, "opacity": 1 } },
    { "name": "float vertical, an eighth", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 500, "expected": { "x": 0, "y": -5.656854, "scale": 1, "opacity": 1 } },
    { "name": "float vertical, half — back at rest", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 2000, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float vertical, three quarters — lowest point", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 3000, "expected": { "x": 0, "y": 8, "scale": 1, "opacity": 1 } },
    { "name": "float vertical, a full cycle — rest again", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 4000, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float vertical, a thousand cycles later — the same phase", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 4001000, "expected": { "x": 0, "y": -8, "scale": 1, "opacity": 1 } },
    { "name": "float vertical, a moment before the node appeared — rest", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": -500, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float horizontal, a quarter — toward the end of the line", "motion": { "kind": "float", "axis": "horizontal", "amplitude": 12, "duration": 2000 }, "t": 500, "expected": { "x": 12, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float horizontal, a quarter, right-to-left — mirrored", "motion": { "kind": "float", "axis": "horizontal", "amplitude": 12, "duration": 2000 }, "t": 500, "direction": "rtl", "expected": { "x": -12, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float horizontal, three quarters — toward the start", "motion": { "kind": "float", "axis": "horizontal", "amplitude": 12, "duration": 2000 }, "t": 1500, "expected": { "x": -12, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float horizontal, three quarters, right-to-left", "motion": { "kind": "float", "axis": "horizontal", "amplitude": 12, "duration": 2000 }, "t": 1500, "direction": "rtl", "expected": { "x": 12, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float both, an eighth — up at the top of the figure eight", "motion": { "kind": "float", "axis": "both", "amplitude": 10, "duration": 4000 }, "t": 500, "expected": { "x": 7.071068, "y": -10, "scale": 1, "opacity": 1 } },
    { "name": "float both, a quarter — at the side, level", "motion": { "kind": "float", "axis": "both", "amplitude": 10, "duration": 4000 }, "t": 1000, "expected": { "x": 10, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "float both, three eighths — down", "motion": { "kind": "float", "axis": "both", "amplitude": 10, "duration": 4000 }, "t": 1500, "expected": { "x": 7.071068, "y": 10, "scale": 1, "opacity": 1 } },
    { "name": "float both, an eighth, right-to-left — only x is mirrored", "motion": { "kind": "float", "axis": "both", "amplitude": 10, "duration": 4000 }, "t": 500, "direction": "rtl", "expected": { "x": -7.071068, "y": -10, "scale": 1, "opacity": 1 } },
    { "name": "delay: before it ends — rest", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000, "delay": 1000 }, "t": 500, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "delay: the moment it ends — rest, the cycle starts", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000, "delay": 1000 }, "t": 1000, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "delay: a quarter cycle after it — highest point", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000, "delay": 1000 }, "t": 2000, "expected": { "x": 0, "y": -8, "scale": 1, "opacity": 1 } },
    { "name": "pulse, at the start — rest", "motion": { "kind": "pulse", "scale": 1.2, "opacity": 0.4, "duration": 2000 }, "t": 0, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "pulse, a quarter — half way", "motion": { "kind": "pulse", "scale": 1.2, "opacity": 0.4, "duration": 2000 }, "t": 500, "expected": { "x": 0, "y": 0, "scale": 1.1, "opacity": 0.7 } },
    { "name": "pulse, half — the peak", "motion": { "kind": "pulse", "scale": 1.2, "opacity": 0.4, "duration": 2000 }, "t": 1000, "expected": { "x": 0, "y": 0, "scale": 1.2, "opacity": 0.4 } },
    { "name": "pulse, three quarters — half way back", "motion": { "kind": "pulse", "scale": 1.2, "opacity": 0.4, "duration": 2000 }, "t": 1500, "expected": { "x": 0, "y": 0, "scale": 1.1, "opacity": 0.7 } },
    { "name": "pulse, a full cycle — rest", "motion": { "kind": "pulse", "scale": 1.2, "opacity": 0.4, "duration": 2000 }, "t": 2000, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "pulse that shrinks, without opacity — opacity stays 1", "motion": { "kind": "pulse", "scale": 0.8, "duration": 1000 }, "t": 500, "expected": { "x": 0, "y": 0, "scale": 0.8, "opacity": 1 } },
    { "name": "pulse of opacity only (scale 1)", "motion": { "kind": "pulse", "scale": 1, "opacity": 0.5, "duration": 1000 }, "t": 500, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 0.5 } },
    { "name": "pulse to full transparency at the peak", "motion": { "kind": "pulse", "scale": 1, "opacity": 0, "duration": 1000 }, "t": 500, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 0 } },
    { "name": "reduce motion: float stands at rest", "motion": { "kind": "float", "axis": "vertical", "amplitude": 8, "duration": 4000 }, "t": 1000, "reducedMotion": true, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } },
    { "name": "reduce motion: pulse stands at rest", "motion": { "kind": "pulse", "scale": 1.2, "opacity": 0.4, "duration": 2000 }, "t": 1000, "reducedMotion": true, "expected": { "x": 0, "y": 0, "scale": 1, "opacity": 1 } }
  ],
  "documentNote": "The value of «motion» on a Text node of an otherwise valid one-screen document; «valid» is the answer of the schema (Zod and the JSON Schema artifact alike). «onRoot» puts the value on the root «Screen» instead.",
  "documentCases": [
