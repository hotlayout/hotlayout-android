{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotlayout.com/schema/theme.json",
  "title": "ThemeContract",
  "x-themeContractVersion": "4.0.1",
  "x-generatedFrom": "src/entities/theme — generated, do not edit by hand",
  "x-compatibility": {
    "policy": {
      "majorMustMatch": true,
      "minorAdditionsAreOptional": true,
      "schemaDescribesExactVersion": true,
      "newerMinor": "read-known-fields-only",
      "unreadableTheme": "fallback-and-report",
      "unknownThemeId": "use-default",
      "customTokens": "declared-by-theme",
      "missingCustomToken": "treat-as-unknown-token",
      "partialTheme": "resolve-missing-to-defaults",
      "partialThemeDefaults": "built-in-theme-of-same-brightness",
      "zeroScaleToken": "none-is-zero",
      "missingRole": "render-neutral",
      "incompleteThemeAppliesTo": "reader-without-validation",
      "protoKeyWithoutValidation": "drop-entry",
      "unknownRoleColor": "neutral-slot",
      "shadowOrder": "first-is-nearest",
      "lengthUnit": "logical-pixels",
      "lineHeightUnit": "font-size-multiple",
      "missingLetterSpacing": "zero",
      "colorAlpha": "rrggbbaa-alpha-last",
      "gradientAngleSpace": "axis-as-css-diagonal-css-to-corner",
      "diagonalGradientGeometry": "css-to-corner",
      "gradientStopOrder": "non-descending",
      "unorderedGradient": "do-not-draw"
    }
  },
  "x-optionalColors": {
    "tokens": [
      "locked",
      "inProgress",
      "completed"
    ],
    "fallbacks": {
      "locked": "muted",
      "inProgress": "accent",
      "completed": "success"
    }
  },
  "x-rules": [
    {
      "id": "defaultThemeExists",
      "description": "«defaultThemeId» names a theme that is present in «themes»."
    },
    {
      "id": "themeKeyMatchesId",
      "description": "The key of a theme in «themes» equals the «id» inside it."
    },
    {
      "id": "sameTokenNamesAcrossThemes",
      "description": "Every theme of the set declares the same token names in each of the six dictionaries. A document refers to a name, not to a theme: a name missing in one theme would make the screen look right until that theme is switched on. The three optional state colors are exempt — they have declared fallbacks («x-optionalColors»)."
    },
    {
      "id": "roleColorsExist",
      "description": "Every color named by a role («roles.badgeTone», «roles.buttonVariant») is declared in the «color» dictionary of the same theme, or is an optional state color."
    },
    {
      "id": "tokenKeysExist",
      "description": "Every key of «origins» and every entry of «provisional» addresses a value the same theme declares («color.primary», «fontFamilies.body»)."
    },
    {
      "id": "gradientStopsAscending",
      "description": "Gradient stops go in non-descending order of «position»: every position is not less than the previous one. Equal positions are ordered — that is a hard color stop."
    },
    {
      "id": "documentTokensExist",
      "description": "A token named by a screen document is declared by the project theme. The document schema checks only the shape of the name; this rule is checked by the document validator against the active theme."
    }
  ],
  "x-gradientGeometry": {
    "coordinates": "normalized box: (0,0) top-left, (1,1) bottom-right, y grows downwards",
    "axis": "as CSS: 0 — to top, 90 — to right, 180 — to bottom, 270 — to left; from the middle of one edge to the middle of the opposite edge",
    "diagonal": "exactly CSS «to <corner>»: 45 — to top right, 135 — to bottom right, 225 — to bottom left, 315 — to top left. The gradient line passes through the center perpendicular to the diagonal joining the two OTHER corners, so the 50% isoline passes through those two corners and the target corner gets position 1",
    "formula": "for a box w×h and direction signs (sx, sy): end = (0.5 + sx·h²/(w²+h²), 0.5 + sy·w²/(w²+h²)), start is symmetric about the center; in Flutter: Alignment(2x−1, 2y−1)",
    "direction": "physical: not mirrored in right-to-left scripts",
    "equalStops": "ordered"
  },
